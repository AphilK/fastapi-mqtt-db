# Docker service names resolve automatically on the Compose network.
HOST_MOSQUITTO=mosquitto
PORT_MOSQUITTO=1883

# Token used by Telegraf to write to the local InfluxDB instance.
# Replace this mock value with the token from admin-token.json for local use.
INFLUXDB_TOKEN=replace-with-a-local-influx-token

# Optional application/database settings kept for the Python services.
HOST_DATABASE=db
USER_DATABASE=app
PASSWORD_DATABASE=replace-with-a-database-password
ROOT_PASSWORD=replace-with-a-root-password
